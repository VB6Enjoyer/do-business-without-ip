---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { useStrings } from '../i18n';

const t = useStrings();
---

<BaseLayout>
  <section class="hero container">
    <div class="copy">
      <p class="kicker">{t.home.kicker}</p>
      <h1>
        Do Business <strong>Without</strong>
        <br />
        Intellectual Property
      </h1>
      <p class="byline">{t.home.byline}</p>
      <p class="lede">{t.home.lede}</p>
      <p class="status" role="status">
        {t.home.comingSoon}
      </p>
    </div>
    <ImagePlaceholder
      class="art"
      label="Hero illustration"
      subject="Ideas flowing freely between people: a lightbulb or open hands motif, no stock-photo businessman"
      ratio="4 / 5"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 300;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-m);
  }

  h1 strong {
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .byline {
    font-size: var(--step-1);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .lede {
    font-size: var(--step-1);
    max-width: 38ch;
  }

  .status {
    display: inline-block;
    margin-top: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    border-radius: 999px;
    background: var(--color-highlight);
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-xl);
    }

    .hero :global(.art) {
      max-width: 24rem;
      justify-self: center;
    }
  }
</style>
