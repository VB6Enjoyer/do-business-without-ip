---
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/Illustration.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { useStrings } from '../i18n';
import { withBase } from '../lib/paths';

const t = useStrings();
---

<BaseLayout>
  <section class="hero container">
    <div class="copy">
      <p class="kicker">{t.home.kicker}</p>
      <h1>
        Do Business <strong>Without</strong>
        <br />
        Intellectual Property
      </h1>
      <p class="byline">{t.home.byline}</p>
      <p class="lede">{t.home.lede}</p>
      <p class="actions">
        <a class="button" href={withBase('/guide/')}>
          {t.home.startReading}
        </a>
        <span class="reading-time">{t.home.readingTime}</span>
      </p>
      <ShareLinks
        url={new URL(withBase('/'), Astro.site).href}
        text={t.share.guideText}
        class="home-share"
      />
    </div>
    <Illustration class="art" name="hero" label={t.home.heroAlt} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 300;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-m);
  }

  h1 strong {
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .byline {
    font-size: var(--step-1);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .lede {
    font-size: var(--step-1);
    max-width: 38ch;
  }

  .copy :global(.home-share) {
    margin-top: var(--space-l);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-m);
    font-family: var(--font-sans);
  }

  .button {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  .reading-time {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-xl);
    }

    .hero :global(.art) {
      max-width: 24rem;
      justify-self: center;
    }
  }
</style>
