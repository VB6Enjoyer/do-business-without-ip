---
/**
 * Footnote reference marker. A plain jump link to the notes list; with JS,
 * the footnote drawer intercepts it (see src/lib/footnote-drawer.ts).
 */
import { useStrings } from '../../i18n';

interface Props {
  n: number;
}

const { n } = Astro.props;
const t = useStrings();
const label = t.guide.footnoteLabel.replace('{n}', String(n));
---

<!-- prettier-ignore -->
<sup class="fn-ref"><a href={`#fn-${n}`} id={`fnref-${n}`} data-fn={n} aria-label={label}>{n}</a></sup>
