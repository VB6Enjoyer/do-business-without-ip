---
/**
 * Editorial update on something in the 2014 text. Always visually marked as an
 * addition so it is never mistaken for the author's words. Phase 3 fills these
 * in; Phase 2 moves them into the drawer.
 */
import { useStrings } from '../../i18n';

interface Props {
  /** Stable identifier, e.g. "sopa-pipa". */
  id: string;
}

const { id } = Astro.props;
const t = useStrings();
---

<aside class="since-2014" id={`since-${id}`} aria-label={t.guide.since2014}>
  <p class="since-2014__label">{t.guide.since2014}</p>
  <slot />
</aside>
