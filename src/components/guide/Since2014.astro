---
/**
 * Marker for an editorial "Since 2014" update. A plain link to the updates
 * list at the end of the guide; with JS, the drawer opens it in place.
 */
import { getEntry } from 'astro:content';
import { defaultLang, useStrings } from '../../i18n';

interface Props {
  /** File name of the update in src/content/updates/<lang>/ (without .md). */
  id: string;
}

const { id } = Astro.props;
const t = useStrings();
const update = await getEntry('updates', `${defaultLang}/${id}`);
if (!update) throw new Error(`Since2014 marker references unknown update "${id}"`);
const label = `${t.guide.since2014}: ${update.data.title}`;
---

<!-- prettier-ignore -->
<a class="update-ref" href={`#since-${id}`} id={`sinceref-${id}`} data-update={id} aria-label={label}>{t.guide.since2014}</a>
