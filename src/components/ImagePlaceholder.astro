---
/**
 * Stand-in for an image that hasn't been made or sourced yet. It reserves
 * the final layout space (via aspect ratio) and records what the real
 * asset should be, so swapping in artwork later is a one-line change.
 */
import { useStrings } from '../i18n';

interface Props {
  /** Short name shown on the placeholder, e.g. "Hero illustration". */
  label: string;
  /** What the final image should depict. Also used as the accessible name. */
  subject: string;
  /** CSS aspect ratio, e.g. "16 / 9". */
  ratio?: string;
  /** Mark decorative images so assistive tech skips them. */
  decorative?: boolean;
  class?: string;
}

const { label, subject, ratio = '16 / 9', decorative = false, class: className } = Astro.props;
const t = useStrings();
---

<figure
  class:list={['image-placeholder', className]}
  style={`--ratio: ${ratio}`}
  data-placeholder={label}
  role={decorative ? 'presentation' : 'img'}
  aria-label={decorative ? undefined : `${t.placeholder.label}: ${subject}`}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="inner" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="glyph">
      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
      <circle cx="9" cy="10" r="2"></circle>
      <path d="m21 16-5-5-9 9"></path>
    </svg>
    <span class="label">{label}</span>
    <span class="subject">{subject}</span>
    <span class="ratio">{ratio.replaceAll(' ', '')}</span>
  </div>
</figure>

<style>
  .image-placeholder {
    margin: 0;
    aspect-ratio: var(--ratio);
    width: 100%;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-m);
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 12px,
        color-mix(in srgb, var(--color-border) 35%, transparent) 12px 13px
      ),
      var(--color-placeholder);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: var(--space-3xs);
    padding: var(--space-s);
    text-align: center;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }

  .glyph {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .label {
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .subject {
    font-size: var(--step--1);
    max-width: 36ch;
  }

  .ratio {
    font-size: 0.75rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
</style>
